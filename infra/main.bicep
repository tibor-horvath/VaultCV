// Provisions everything VaultCV needs in one resource group: a storage account
// (profile blobs + share-link table) and a Static Web App with its application
// settings already filled in. The site code itself is deployed separately by
// .github/workflows/deploy-azure.yml using the Static Web App's deployment token.
//
// See docs/deployment-azure.md for usage.

targetScope = 'resourceGroup'

@description('Name of the Static Web App. Shown in the Azure Portal; the public URL is generated by Azure.')
@minLength(2)
@maxLength(40)
param appName string

@description('Slug used in profile blob names, for example john-doe.')
param profileSlug string

@description('Region for the storage account. Defaults to the resource group region.')
param location string = resourceGroup().location

@description('Region for the Static Web App. Static Web Apps is only offered in these regions.')
@allowed([
  'westus2'
  'centralus'
  'eastus2'
  'westeurope'
  'eastasia'
])
param staticWebAppLocation string = 'westeurope'

@description('Static Web Apps plan. Free is enough for VaultCV.')
@allowed([
  'Free'
  'Standard'
])
param sku string = 'Free'

@description('Globally unique storage account name (3-24 lowercase letters and digits). Generated when left empty.')
@maxLength(24)
param storageAccountName string = ''

@description('Blob container that holds the profile JSON and photos.')
param profileContainerName string = 'profiles'

@description('Table Storage table that holds share links.')
param shareLinksTableName string = 'sharelinks'

@description('Secret used to sign session tokens. A new random value is generated on every deployment unless you pass one, which signs out active sessions.')
@secure()
param sessionSigningKey string = '${newGuid()}${newGuid()}'

@description('Session token lifetime in seconds.')
@minValue(60)
@maxValue(86400)
param sessionTtlSeconds int = 3600

@description('Optional comma-separated origin allowlist for admin mutations, for example https://example.com,https://www.example.com.')
param allowedOrigins string = ''

var resolvedStorageAccountName = empty(storageAccountName)
  ? 'stcv${uniqueString(resourceGroup().id, appName)}'
  : storageAccountName

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: resolvedStorageAccountName
  location: location
  kind: 'StorageV2'
  sku: {
    name: 'Standard_LRS'
  }
  properties: {
    accessTier: 'Hot'
    allowBlobPublicAccess: false
    // The API authenticates with a connection string, which needs shared key access.
    allowSharedKeyAccess: true
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
  }

  resource blobService 'blobServices' = {
    name: 'default'

    resource profileContainer 'containers' = {
      name: profileContainerName
      properties: {
        publicAccess: 'None'
      }
    }
  }

  resource tableService 'tableServices' = {
    name: 'default'

    resource shareLinksTable 'tables' = {
      name: shareLinksTableName
    }
  }
}

var storageConnectionString = 'DefaultEndpointsProtocol=https;AccountName=${storage.name};AccountKey=${storage.listKeys().keys[0].value};EndpointSuffix=${environment().suffixes.storage}'

// Not linked to a repository: linking from a template requires a GitHub token.
// The deploy workflow pushes the build with the deployment token instead.
resource staticWebApp 'Microsoft.Web/staticSites@2024-04-01' = {
  name: appName
  location: staticWebAppLocation
  sku: {
    name: sku
    tier: sku
  }
  properties: {
    allowConfigFileUpdates: true
    stagingEnvironmentPolicy: 'Disabled'
  }

  // This resource replaces the whole set of application settings on every
  // deployment, so settings added by hand in the Portal are removed.
  resource appSettings 'config' = {
    name: 'appsettings'
    properties: union(
      {
        CV_SESSION_SIGNING_KEY: sessionSigningKey
        CV_SESSION_TTL_SECONDS: string(sessionTtlSeconds)
        CV_PROFILE_SLUG: profileSlug
        CV_PROFILE_CONTAINER: profileContainerName
        CV_SHARELINKS_TABLE: shareLinksTableName
        // Used for both the profile blobs and the share-link table.
        AZURE_STORAGE_CONNECTION_STRING: storageConnectionString
      },
      empty(allowedOrigins) ? {} : { CV_ALLOWED_ORIGINS: allowedOrigins }
    )
  }
}

@description('Public URL of the site.')
output siteUrl string = 'https://${staticWebApp.properties.defaultHostname}'

@description('Name of the Static Web App, for az staticwebapp commands.')
output staticWebAppName string = staticWebApp.name

@description('Name of the storage account.')
output storageAccountName string = storage.name
