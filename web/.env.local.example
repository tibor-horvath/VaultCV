# Minimal local setup for UI-only work — no Azure, no Functions host required.
#
#   cp .env.local.example .env.local
#   npm run dev
#
# Serves a fully populated mock CV from the web source. See docs/mock-data.md.
# Mock mode only applies to `npm run dev`; it is never used in a production build.
VITE_USE_MOCK_CV=1
