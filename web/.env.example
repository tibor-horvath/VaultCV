# Full list of web environment variables, with local-development defaults.
#
#   cp .env.example .env.local
#   npm run dev
#
# All VITE_* variables are BUILD-TIME: they are inlined by `npm run build`.
# Never put secrets here — everything below ships in the public bundle.
# `.env.local` is gitignored; `.env.example` is committed.

# --- Mock CV mode ---------------------------------------------------------
# 1 = serve a built-in sample CV instead of calling the API (dev server only).
# Unset or 0 = call the real API. See docs/mock-data.md.
VITE_USE_MOCK_CV=1

# --- API dev proxy --------------------------------------------------------
# Where the Vite dev server forwards /api/* requests. Only used by `npm run dev`;
# in production the site and API share one origin. Default: http://localhost:7071
# (the Azure Functions Core Tools host). Set to http://localhost:4280 if you run
# the Static Web Apps CLI instead.
# VITE_API_PROXY_TARGET=http://localhost:7071

# --- Public landing page text --------------------------------------------
# Fallbacks shown before/without public profile data from GET /api/public-profile.
# See docs/public-home-page.md.
VITE_PUBLIC_NAME=Jane Smith
VITE_PUBLIC_TITLE=Senior Software Engineer

# --- Branding (site footer + generated PDF footer) ------------------------
# Optional. Each falls back to the VaultCV defaults when unset.
# VITE_BRAND_NAME=VaultCV
# VITE_BRAND_REPO_URL=https://github.com/tibor-horvath/VaultCV
# VITE_BRAND_LINKEDIN_URL=https://www.linkedin.com/in/htibor/
# VITE_BRAND_COPYRIGHT_NAME=Tibor Horvath
